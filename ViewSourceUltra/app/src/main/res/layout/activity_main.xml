<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/paper" android:layoutDirection="rtl">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/navy" android:padding="20dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="View Source Ultra" android:textColor="@color/white" android:textSize="28sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="المصدر الأصلي الكامل للصفحة — كما يرسله الخادم" android:textColor="#B9C6D8" android:textSize="13sp"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:orientation="vertical"><EditText android:id="@+id/urlInput" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/field" android:paddingLeft="14dp" android:paddingRight="14dp" android:hint="https://example.com/page" android:singleLine="true" android:inputType="textUri" android:textDirection="ltr" android:gravity="center_vertical|left"/><Button android:id="@+id/fetchButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:text="جلب View Source الكامل" android:textColor="@color/white" android:textStyle="bold" android:textSize="16sp" android:background="@drawable/primary"/><ProgressBar android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" style="?android:attr/progressBarStyleHorizontal" android:visibility="gone"/><TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="جاهز" android:textColor="@color/muted" android:textSize="12sp"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="14dp" android:paddingRight="14dp"><Button android:id="@+id/copyButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:text="نسخ الكل" android:enabled="false"/><Button android:id="@+id/saveButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_marginStart="8dp" android:text="حفظ المصدر" android:enabled="false"/><Button android:id="@+id/shareButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_marginStart="8dp" android:text="مشاركة" android:enabled="false"/></LinearLayout>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_margin="14dp" android:fillViewport="true" android:background="@drawable/dark"><ScrollView android:layout_width="wrap_content" android:layout_height="match_parent" android:fillViewport="true"><TextView android:id="@+id/sourceView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="1000dp" android:padding="14dp" android:text="ألصق رابط الصفحة ثم اضغط جلب المصدر." android:textColor="#D7E3F4" android:textSize="11sp" android:fontFamily="monospace" android:textIsSelectable="true" android:textDirection="ltr" android:gravity="left|top"/></ScrollView></HorizontalScrollView>
</LinearLayout>
