package com.acrps.voxaride;

import android.app.*;import android.os.*;import android.content.*;import android.graphics.*;import android.graphics.drawable.*;import android.speech.RecognizerIntent;import android.view.*;import android.widget.*;import java.text.*;import java.util.*;

public class MainActivity extends Activity{
 static final int NAVY=Color.rgb(18,26,43),ORANGE=Color.rgb(245,158,11),PAPER=Color.rgb(244,246,250),MUTED=Color.rgb(100,116,139),GREEN=Color.rgb(22,163,74),REQ=2026;
 FrameLayout root; LinearLayout body; final ArrayList<Ride> rides=new ArrayList<>(); EditText dest;
 public void onCreate(Bundle b){super.onCreate(b);getWindow().setStatusBarColor(NAVY);seed();root=new FrameLayout(this);setContentView(root);access();}
 void access(){root.removeAllViews();root.setBackgroundColor(NAVY);LinearLayout p=col();p.setPadding(dp(26),dp(60),dp(26),dp(30));TextView logo=t("V",40,Color.WHITE,true);logo.setGravity(17);logo.setBackground(circle(ORANGE));p.addView(logo,new LinearLayout.LayoutParams(dp(90),dp(90)));p.addView(t("VoxaRide",34,Color.WHITE,true));p.addView(t("Voice-first mobility assistant",16,Color.LTGRAY,false));p.addView(space(28));LinearLayout card=card();card.addView(t("Enter access key",21,NAVY,true));card.addView(t("Enter your assigned access key to continue.",14,MUTED,false));EditText k=new EditText(this);k.setHint("Access key");k.setSingleLine();card.addView(k,new LinearLayout.LayoutParams(-1,dp(56)));TextView err=t("",13,Color.rgb(220,38,38),true);err.setVisibility(View.GONE);card.addView(err);Button go=btn("Continue",NAVY,Color.WHITE);card.addView(go);Button off=btn("Continue in offline mode",ORANGE,NAVY);off.setVisibility(View.GONE);card.addView(off);go.setOnClickListener(v->{err.setVisibility(View.VISIBLE);err.setText("2026ai".equalsIgnoreCase(k.getText().toString().trim())?"This key is outdated. Ask your administrator for the latest access key.":"Access key not recognized. Please try a current key.");off.setVisibility(View.VISIBLE);});off.setOnClickListener(v->shell());p.addView(card,new LinearLayout.LayoutParams(-1,-2));p.addView(space(24));TextView f=t("Version 2.6.08 • Secure access",12,Color.GRAY,false);f.setGravity(17);p.addView(f);ScrollView s=new ScrollView(this);s.addView(p);root.addView(s,new FrameLayout.LayoutParams(-1,-1));}
 void shell(){root.removeAllViews();LinearLayout all=col();all.setBackgroundColor(PAPER);LinearLayout top=new LinearLayout(this);top.setGravity(16);top.setPadding(dp(18),dp(10),dp(18),dp(10));top.setBackgroundColor(Color.WHITE);top.addView(t("VoxaRide",24,NAVY,true),new LinearLayout.LayoutParams(0,dp(45),1));top.addView(tag("VOICE READY"));all.addView(top);body=col();ScrollView sc=new ScrollView(this);sc.addView(body);all.addView(sc,new LinearLayout.LayoutParams(-1,0,1));LinearLayout nav=new LinearLayout(this);nav.setBackgroundColor(Color.WHITE);String[] n={"Home","Activity","Voice","About"};for(String x:n){Button b=btn(x,Color.TRANSPARENT,NAVY);nav.addView(b,new LinearLayout.LayoutParams(0,dp(58),1));if(x.equals("Home"))b.setOnClickListener(v->home());if(x.equals("Activity"))b.setOnClickListener(v->activity());if(x.equals("Voice"))b.setOnClickListener(v->voice());if(x.equals("About"))b.setOnClickListener(v->about());}all.addView(nav);root.addView(all,new FrameLayout.LayoutParams(-1,-1));home();}
 void home(){body.removeAllViews();pad();body.addView(t("Good afternoon, Alex",29,NAVY,true));body.addView(t("Book a ride by voice or text.",15,MUTED,false));body.addView(space(18));LinearLayout c=card();c.addView(t("VOICE ASSISTANT",13,ORANGE,true));c.addView(t("Where would you like to go?",23,NAVY,true));Button b=btn("Speak destination",NAVY,Color.WHITE);b.setOnClickListener(v->listen());c.addView(b);body.addView(c);body.addView(space(18));body.addView(t("Recent request",20,NAVY,true));body.addView(rideCard(rides.get(0)));}
 void voice(){body.removeAllViews();pad();body.addView(t("Voice booking",29,NAVY,true));body.addView(t("Speak your destination and review the request instantly.",15,MUTED,false));body.addView(space(18));LinearLayout c=card();dest=new EditText(this);dest.setHint("Type a destination");c.addView(dest,new LinearLayout.LayoutParams(-1,dp(56)));Button s=btn("Use voice",ORANGE,NAVY);s.setOnClickListener(v->listen());c.addView(s);Button q=btn("Request ride",NAVY,Color.WHITE);q.setOnClickListener(v->request(dest.getText().toString()));c.addView(q);body.addView(c);}
 void listen(){try{Intent i=new Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH);i.putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL,RecognizerIntent.LANGUAGE_MODEL_FREE_FORM);i.putExtra(RecognizerIntent.EXTRA_PROMPT,"Say your destination");startActivityForResult(i,REQ);}catch(Exception e){Toast.makeText(this,"Speech recognition is unavailable",Toast.LENGTH_LONG).show();}}
 protected void onActivityResult(int r,int c,Intent d){super.onActivityResult(r,c,d);if(r==REQ&&c==RESULT_OK&&d!=null){ArrayList<String>a=d.getStringArrayListExtra(RecognizerIntent.EXTRA_RESULTS);if(a!=null&&!a.isEm